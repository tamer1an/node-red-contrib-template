# LinkedIn Credentials for Local Testing
# Copy this file to .env and fill in your LinkedIn credentials
# .env is ignored by git for security - NEVER commit actual credentials

# Your LinkedIn email address
LINKEDIN_EMAIL=your-email@example.com

# Your LinkedIn password
LINKEDIN_PASSWORD=your-password

# Optional: Test recipient for sending test messages
# Can be a conversation ID (urn:li:member:123456) or profile ID
TEST_RECIPIENT_ID=urn:li:member:123456
