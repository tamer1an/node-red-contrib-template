{
  "name": "node-red-contrib-linkedin-service-bot",
  "version": "1.0.0",
  "description": "Node-RED nodes for interacting with LinkedIn messages",
  "main": "linkedin-service-bot.js",
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^24.0.14",
    "@types/node": "^11.13.4",
    "@types/node-red": "^0.17.3",
    "@types/react": "^16.8.13",
    "@types/react-dom": "^16.8.4",
    "enzyme": "^3.9.0",
    "enzyme-adapter-react-16": "^1.14.0",
    "jest-enzyme": "^7.0.2",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "react-scripts": "^3.0.1",
    "sinon": "^7.3.2",
    "typescript": "^3.5.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "linkedin-private-api": "^1.1.2"
  },
  "node-red": {
    "nodes": {
      "linkedin-service-bot": "linkedin-service-bot.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:cli": "tsc ./src/cli.ts ./src/lib/linkedinClient.ts ./src/lib/testRunner.ts --skipLibCheck --target es6 --module commonjs --outDir ./dist",
    "start": "react-scripts start",
    "test": "react-scripts test",
    "test:local": "node -r ts-node/register ./src/cli.ts",
    "test:local:build": "npm run build:cli && node ./dist/cli.js",
    "coverage": "npm test -- --coverage",
    "eject": "react-scripts eject"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamer1an/node-red-contrib-template.git"
  },
  "keywords": [
    "node-red",
    "github",
    "red",
    "iot"
  ],
  "author": {
    "name": "Stefan W; Andrii Trybynenko",
    "email": "scaw.dev@gmail.com; tamerjlah@gmail.com",
    "url": "https://github.com/tamer1an/"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tamer1an/node-red-contrib-template/issues"
  },
  "homepage": "https://github.com/tamer1an/node-red-contrib-template#readme",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
